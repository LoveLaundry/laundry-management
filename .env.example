# MongoDB — same three-database architecture as bill_service
MONGODB_MAIN_URI=mongodb://localhost:27017
MONGODB_MAIN_DB=laundry_management
MONGODB_SECONDARY_URI=
MONGODB_SECONDARY_DB=
MONGODB_LOCAL_URI=
MONGODB_LOCAL_DB=

# Encryption (CRITICAL — must be set identically to the other backend services)
MASTER_KEY=CHANGE-ME-IN-PRODUCTION-love-laundry-2026

# JWT (must match user-service JWT_SECRET so tokens verify)
JWT_SECRET=CHANGE-ME-IN-PRODUCTION-love-laundry-2026

# ─── Timezone ───────────────────────────────────────────────────────────────
# All business days, reports and "today" run on Sri Lanka time. The code pins
# this itself (see app_time.py), so this only matters for anything that falls
# back to the host clock — logs, third-party libs, `date` in a shell.
TZ=Asia/Colombo
